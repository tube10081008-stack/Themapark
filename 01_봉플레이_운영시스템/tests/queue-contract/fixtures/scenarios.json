        { "t": 86400, "op": "submit", "args": { "clientRequestId": "f0000000-0000-4000-8000-000000000004", "consent": { "consent_id": "cst_f4" } }, "expect": { "ok": true, "queue_no": 1, "business_date": "2026-10-11" }, "why": "다음 영업일 번호는 1부터" },
        { "t": 86401, "op": "myStatus", "args": { "token": "$tok" }, "expect": { "ok": false, "error": { "code": "TOKEN_INVALID" } }, "why": "토큰은 해당 영업일까지" }
      ]
    },
    {
      "id": "S8_kst_business_date_boundary",
      "steps": [
        { "t": 50399, "op": "submit", "args": { "clientRequestId": "90000000-0000-4000-8000-000000000001", "consent": { "consent_id": "cst_g1" } }, "expect": { "queue_no": 1, "business_date": "2026-10-10" }, "why": "23:59:59 KST" },
        { "t": 50400, "op": "submit", "args": { "clientRequestId": "90000000-0000-4000-8000-000000000002", "consent": { "consent_id": "cst_g2" } }, "expect": { "queue_no": 1, "business_date": "2026-10-11" }, "why": "00:00:00 KST = 15:00Z. UTC 날짜(10-10) 기준이면 2번이 되므로 실패해야 함" }
      ]
    }
  ]
